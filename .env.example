# LLM Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tracing (LangSmith)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-research-lab

# Search (Tavily - optional, mock fallback available)
TAVILY_API_KEY=

# Workflow Settings
APP_ENV=local
LOG_LEVEL=INFO
MAX_ITERATIONS=6
TIMEOUT_SECONDS=60
ENABLE_CRITIC=true
